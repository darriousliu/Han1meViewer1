<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- 应用锁走 LocalAuthentication，用 Face ID 必须声明用途 -->
	<key>NSFaceIDUsageDescription</key>
	<string>Unlock the app with Face ID</string>
	<!-- 保存封面/预览图到相册 -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save images to your photo library</string>
	<!--
	  这一项就是 Xcode 里的「Audio, AirPlay, and Picture in Picture」，
	  是画中画与 AirPlay 的前提，少了它画中画根本起不来（库的 README_VIDEO 也这么要求）。
	  本应用不做后台纯音频播放：不开画中画时进后台，系统会把带画面的播放直接停掉。
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>