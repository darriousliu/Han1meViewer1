<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- 应用锁走 LocalAuthentication，用 Face ID 必须声明用途 -->
	<key>NSFaceIDUsageDescription</key>
	<string>Unlock the app with Face ID</string>
	<!-- 保存封面/预览图到相册 -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save images to your photo library</string>
	<!--
	  audio 这一项同时是三件事的前提：退到后台只留音频继续播、画中画、AirPlay。
	  少了它，系统会在应用进后台时直接把播放停掉，画中画也起不来。
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>