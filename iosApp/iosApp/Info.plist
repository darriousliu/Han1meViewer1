<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- 应用锁走 LocalAuthentication，用 Face ID 必须声明用途 -->
	<key>NSFaceIDUsageDescription</key>
	<string>Unlock the app with Face ID</string>
	<!-- 保存封面/预览图到相册 -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save images to your photo library</string>
	<!--
	  签到提醒写进系统日历（EventKit）。iOS 17 起只申请「只写」权限，用
	  NSCalendarsWriteOnlyAccessUsageDescription；15/16 走全量权限，用 NSCalendarsUsageDescription。
	  两个都要留着，少哪个对应系统上就会在申请权限时直接崩。
	-->
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>Add check-in reminders to your calendar</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Add check-in reminders to your calendar</string>
	<!--
	  这一项就是 Xcode 里的「Audio, AirPlay, and Picture in Picture」，
	  是画中画与 AirPlay 的前提，少了它画中画根本起不来（库的 README_VIDEO 也这么要求）。
	  本应用不做后台纯音频播放：不开画中画时进后台，系统会把带画面的播放直接停掉。
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!--
	  外部入口。Universal Links 用不了（要在 hanime1.com 上放 apple-app-site-association，
	  域名不是我们的），所以只注册自己的 scheme：han1meviewer://watch?v=xxxx 一类。
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>io.github.daisukikaffuchino.han1meviewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>han1meviewer</string>
			</array>
		</dict>
	</array>
	<!--
	  「文件」App 里对视频选「打开方式」能选到本应用，用来本地播放。
	  LSSupportsOpeningDocumentsInPlace 表示就地打开而不是拷贝一份进沙盒——
	  代价是拿到的 URL 在沙盒外，读之前要开安全作用域（见 IosDeepLink）。
	-->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Video</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.movie</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
